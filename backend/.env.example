# ==========================
# DOD Healthcare Backend ENV
# ==========================

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Get from: https://cloud.mongodb.com -> Connect -> Drivers
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/dod-healthcare?retryWrites=true&w=majority

# JWT Secret (make this a long random string)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_123456

# JWT Expiry
JWT_EXPIRES_IN=7d

# ImageKit.io Credentials (media storage)
# Get from: https://imagekit.io -> Developer Options -> API Keys / URL Endpoints
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Cloudinary Credentials (LEGACY — only needed to run the one-time migration
# script that copies existing media to ImageKit. Safe to remove after migration.)
# Get from: https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Admin Credentials (first-time setup - change after first login)
ADMIN_EMAIL=admin@dodhealthcare.com
ADMIN_PASSWORD=Admin@123

# Frontend URL (for CORS) - update after deployment
FRONTEND_URL=http://localhost:3000

# ─── STORAGE DRIVER ──────────────────────────────────────────────────────────
# Which provider NEW uploads go to. Existing records keep the URL already saved
# on them either way, so flipping this is reversible.
#   imagekit  (default, current behaviour)
#   r2        (Cloudflare R2 + custom domain)
STORAGE_DRIVER=imagekit

# ─── CLOUDFLARE R2 ───────────────────────────────────────────────────────────
# Only needed when STORAGE_DRIVER=r2 (or to run `npm run migrate:r2`).
# See cloudflare/SETUP.md for where each of these comes from.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dod-media
# The custom domain bound to the bucket — NOT the r2.cloudflarestorage.com
# endpoint, which is uncached and requires signed requests.
R2_PUBLIC_BASE=https://cdn.dodsmarthealth.com
